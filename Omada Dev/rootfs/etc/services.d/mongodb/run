#!/usr/bin/with-contenv bashio

bashio::log.info "Starting internal MongoDB..."

DATA_DIR="/opt/tplink/EAPController/data/db"
LOG_DIR="/opt/tplink/EAPController/logs"

mkdir -p "$DATA_DIR" "$LOG_DIR"
chown -R 508:508 "$DATA_DIR" "$LOG_DIR"

if bashio::config.true 'fix_mongodb_memory'; then
    bashio::log.warning "fix_mongodb_memory enabled: disabling ASLR to fix tcmalloc mmap alignment failures"
    if command -v setarch >/dev/null 2>&1; then
        exec setarch "$(uname -m)" -R gosu 508:508 mongod \
            --dbpath "$DATA_DIR" --port 27217 --bind_ip 127.0.0.1 \
            --logpath "$LOG_DIR/mongod.log" --logappend
    fi
    bashio::log.warning "setarch not found; starting mongod without ASLR fix (ensure util-linux is installed)"
fi

exec gosu 508:508 mongod \
    --dbpath "$DATA_DIR" --port 27217 --bind_ip 127.0.0.1 \
    --logpath "$LOG_DIR/mongod.log" --logappend
